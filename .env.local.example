# Site — must match the actual primary domain exactly (including www, if
# that's what's configured as primary in your host's domain settings),
# since this drives every canonical URL, hreflang tag, sitemap entry, and
# schema.org URL. A mismatch here means canonical tags point at a URL that
# just redirects instead of being self-referencing.
NEXT_PUBLIC_SITE_URL=https://www.saudimoneyguide.com

# SendGrid — newsletter signup (app/api/email/subscribe)
# Both are required. Without them signup returns 503 instead of losing emails.
SENDGRID_API_KEY=
SENDGRID_LIST_ID=
# Optional generated custom-field ID used to store language (for example e1_T).
SENDGRID_LOCALE_FIELD_ID=

# Affiliate tracking — optional webhook to forward click/signup events to
# a platform like Refersion, Tapfiliate, or CJ Affiliate. Without this,
# events are still recorded via console.log (app/api/affiliate/track).
AFFILIATE_TRACKING_WEBHOOK_URL=
